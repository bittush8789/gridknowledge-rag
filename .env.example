# GridKnowledge RAG Configuration Template
# Copy this file to .env and configure your enterprise keys

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-with-a-strong-random-secret
JWT_SECRET=replace-with-a-strong-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///data/gridknowledge.db

# LLM Providers (Groq primary inference, OpenAI fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=gridknowledge-rag
PINECONE_ENVIRONMENT=us-east-1

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=gridknowledge-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Guardrails & Safety
MAX_QUERY_LENGTH=1000
MIN_QUERY_LENGTH=2
ENABLE_PROMPT_INJECTION_DEFENSE=true
ENABLE_JAILBREAK_DETECTION=true
ENABLE_PII_MASKING=true
ENABLE_DATA_LEAKAGE_PREVENTION=true
ENABLE_OUTPUT_GROUNDING_CHECK=true
